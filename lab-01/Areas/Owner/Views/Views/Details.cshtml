@model BookingReadDto

@{
    ViewData["Title"] = "Деталі бронювання";
}


<h1 class="mb-4">
    Деталі бронювання
</h1>


<dl class="row">

    <dt class="col-sm-3">
        Готель
    </dt>

    <dd class="col-sm-9">
        @Model.HotelName
    </dd>


    <dt class="col-sm-3">
        Кімната
    </dt>

    <dd class="col-sm-9">
        @Model.RoomNumber
    </dd>


    <dt class="col-sm-3">
        Користувач
    </dt>

    <dd class="col-sm-9">
        @(Model.UserEmail ?? "—")
    </dd>


    <dt class="col-sm-3">
        Дата заселення
    </dt>

    <dd class="col-sm-9">
        @Model.CheckIn.ToString("dd.MM.yyyy")
    </dd>


    <dt class="col-sm-3">
        Дата виселення
    </dt>

    <dd class="col-sm-9">
        @Model.CheckOut.ToString("dd.MM.yyyy")
    </dd>


    <dt class="col-sm-3">
        Кількість ночей
    </dt>

    <dd class="col-sm-9">

        @((Model.CheckOut.Date -
            Model.CheckIn.Date).Days)

    </dd>


    <dt class="col-sm-3">
        Загальна вартість
    </dt>

    <dd class="col-sm-9">
        @Model.TotalPrice.ToString("0.00")
    </dd>


    <dt class="col-sm-3">
        Створено
    </dt>

    <dd class="col-sm-9">
        @Model.CreatedAt.ToString(
            "dd.MM.yyyy HH:mm"
        )
    </dd>

</dl>


<a asp-area="Owner"
   asp-controller="Bookings"
   asp-action="Index"
   class="btn btn-secondary">

    Назад

</a>