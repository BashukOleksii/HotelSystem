@model OwnerBookingIndexViewModel

@{
    ViewData["Title"] = "Бронювання";
}


<div class="d-flex justify-content-between
    align-items-center mb-4">

    <h1>
        Бронювання моїх готелів
    </h1>

</div>


<div asp-validation-summary="ModelOnly"
     class="text-danger mb-3">
</div>


<form method="get"
      asp-area="Owner"
      asp-controller="Bookings"
      asp-action="Index"
      class="row g-3 mb-4">


    <div class="col-md-3">

        <label class="form-label">
            Готель
        </label>

        <select name="HotelId"
                class="form-select">

            <option value="">
                Всі готелі
            </option>

            @foreach (HotelReadDto hotel
                in Model.Hotels)
            {
                <option value="@hotel.Id"
                        selected="@(Model.Filter.HotelId == hotel.Id)">

                    @hotel.Name

                </option>
            }

        </select>

    </div>


    <div class="col-md-2">

        <label class="form-label">
            Від
        </label>

        <input type="date"
               name="From"
               value="@Model.Filter.From?.ToString("yyyy-MM-dd")"
               class="form-control" />

    </div>


    <div class="col-md-2">

        <label class="form-label">
            До
        </label>

        <input type="date"
               name="To"
               value="@Model.Filter.To?.ToString("yyyy-MM-dd")"
               class="form-control" />

    </div>


    <div class="col-md-3">

        <label class="form-label">
            Сортування
        </label>

        <select name="SortBy"
                class="form-select">

            <option value="">
                За датою створення
            </option>

            <option value="checkin"
                    selected="@(Model.Filter.SortBy == "checkin")">

                Дата заселення

            </option>

            <option value="checkout"
                    selected="@(Model.Filter.SortBy == "checkout")">

                Дата виселення

            </option>

            <option value="price"
                    selected="@(Model.Filter.SortBy == "price")">

                Вартість

            </option>

            <option value="createdat"
                    selected="@(Model.Filter.SortBy == "createdat")">

                Дата створення

            </option>

        </select>

    </div>


    <div class="col-md-2
        d-flex align-items-end">

        <button type="submit"
                class="btn btn-outline-primary w-100">

            Застосувати

        </button>

    </div>

</form>


@if (Model.Bookings.Items.Count == 0)
{
    <div class="alert alert-info">

        Бронювань за заданими параметрами
        не знайдено.

    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped
            table-hover align-middle">

            <thead>

                <tr>

                    <th>
                        Готель
                    </th>

                    <th>
                        Кімната
                    </th>

                    <th>
                        Користувач
                    </th>

                    <th>
                        Заселення
                    </th>

                    <th>
                        Виселення
                    </th>

                    <th>
                        Вартість
                    </th>

                    <th class="text-end">
                        Дії
                    </th>

                </tr>

            </thead>


            <tbody>

                @foreach (BookingReadDto booking
                    in Model.Bookings.Items)
                {
                    <tr>

                        <td>
                            @booking.HotelName
                        </td>

                        <td>
                            @booking.RoomNumber
                        </td>

                        <td>
                            @(booking.UserEmail ?? "—")
                        </td>

                        <td>
                            @booking.CheckIn.ToString("dd.MM.yyyy")
                        </td>

                        <td>
                            @booking.CheckOut.ToString("dd.MM.yyyy")
                        </td>

                        <td>
                            @booking.TotalPrice.ToString("0.00")
                        </td>


                        <td class="text-end">

                            <a asp-area="Owner"
                               asp-controller="Bookings"
                               asp-action="Details"
                               asp-route-id="@booking.Id"
                               class="btn btn-sm
                                btn-outline-secondary">

                                Деталі

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

        @if (Model.Bookings.TotalPages > 1)
        {
            <nav class="mt-3">

                <ul class="pagination">

                    @for (
                        int pageNumber = 1;
                        pageNumber <= Model.Bookings.TotalPages;
                        pageNumber++)
                    {
                        <li class="
                            page-item
                            @(pageNumber == Model.Bookings.Page
                                ? "active"
                                : "")
                            ">

                            <a class="page-link"
                               asp-area="Owner"
                               asp-controller="Bookings"
                               asp-action="Index"
                               asp-route-HotelId="@Model.Filter.HotelId"
                               asp-route-RoomId="@Model.Filter.RoomId"
                               asp-route-From="@Model.Filter.From?.ToString("yyyy-MM-dd")"
                               asp-route-To="@Model.Filter.To?.ToString("yyyy-MM-dd")"
                               asp-route-SortBy="@Model.Filter.SortBy"
                               asp-route-Descending="@Model.Filter.Descending"
                               asp-route-Page="@pageNumber"
                               asp-route-PageSize="@Model.Filter.PageSize">

                                @pageNumber

                            </a>

                        </li>
                    }

                </ul>

            </nav>
        }

    </div>
}