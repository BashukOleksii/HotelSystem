@model HotelReadDto

@{
    ViewData["Title"] = Model.Name;
}


<div class="d-flex justify-content-between
            align-items-center mb-4">

    <h1>
        @Model.Name
    </h1>


    <div>

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">

            Редагувати

        </a>

        <a asp-action="Index"
           class="btn btn-secondary">

            Назад

        </a>

        <a asp-area="Owner"
           asp-controller="Rooms"
           asp-action="Index"
           asp-route-hotelId="@Model.Id"
           class="btn btn-success">

            Кімнати

        </a>

        <a asp-area="Owner"
           asp-controller="Bookings"
           asp-action="Index"
           asp-route-HotelId="@Model.Id"
           class="btn btn-info">

            Бронювання

        </a>

    </div>

</div>


@if (!string.IsNullOrWhiteSpace(
    Model.Description))
{
    <p class="lead">
        @Model.Description
    </p>
}


<hr />

@if (Model.PhotoUrls.Count > 0)
{
    <div class="row g-3 mb-4">

        @foreach (string photo
            in Model.PhotoUrls)
        {
            <div class="col-md-4">

                <img src="@photo"
                     alt="@Model.Name"
                     class="img-fluid rounded shadow-sm"
                     style="width:100%;height:250px;object-fit:cover;" />

            </div>
        }

    </div>
}

<h4>
    Адреса
</h4>

<p>
    @Model.Address.City,
    @Model.Address.Street
    @Model.Address.Number
</p>