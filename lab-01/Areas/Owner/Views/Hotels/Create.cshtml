@model HotelCreateViewModel

@{
    ViewData["Title"] = "Новий готель";
}


<h1 class="mb-4">
    Новий готель
</h1>


<form method="post"
      enctype="multipart/form-data"
      asp-area="Owner"
      asp-controller="Hotels"
      asp-action="Create">


    <div asp-validation-summary="All"
         class="text-danger mb-3">
    </div>


    <div class="mb-3">

        <label asp-for="Form.Name"
               class="form-label">
            Назва
        </label>

        <input asp-for="Form.Name"
               class="form-control" />

        <span asp-validation-for="Form.Name"
              class="text-danger">
        </span>

    </div>


    <div class="mb-3">

        <label asp-for="Form.Description"
               class="form-label">
            Опис
        </label>

        <textarea asp-for="Form.Description"
                  class="form-control"
                  rows="4">
        </textarea>

    </div>


    <h4 class="mt-4">
        Адреса
    </h4>


    <div class="row">

        <div class="col-md-4 mb-3">

            <label asp-for="Form.Address.City"
                   class="form-label">
                Місто
            </label>

            <input asp-for="Form.Address.City"
                   class="form-control" />

        </div>


        <div class="col-md-5 mb-3">

            <label asp-for="Form.Address.Street"
                   class="form-label">
                Вулиця
            </label>

            <input asp-for="Form.Address.Street"
                   class="form-control" />

        </div>


        <div class="col-md-3 mb-3">

            <label asp-for="Form.Address.Number"
                   class="form-label">
                Номер
            </label>

            <input asp-for="Form.Address.Number"
                   class="form-control" />

        </div>

    </div>


    <div class="mb-4">

        <label asp-for="Photos"
               class="form-label">
            Фотографії готелю
        </label>

        <input asp-for="Photos"
               type="file"
               multiple
               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
               class="form-control" />

        <div class="form-text">
            До 10 фото. JPG, PNG або WEBP. Максимум 5 МБ на файл.
        </div>

    </div>


    <button type="submit"
            class="btn btn-primary">
        Створити
    </button>

    <a asp-area="Owner"
       asp-controller="Hotels"
       asp-action="Index"
       class="btn btn-secondary">
        Скасувати
    </a>

</form>