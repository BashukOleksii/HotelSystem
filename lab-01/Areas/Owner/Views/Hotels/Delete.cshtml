@model HotelReadDto

@{
    ViewData["Title"] = "Видалення готелю";
}


<h1>
    Видалення готелю
</h1>


<div class="alert alert-warning">

    Ви впевнені, що хочете видалити
    <strong>@Model.Name</strong>?

</div>


<dl class="row">

    <dt class="col-sm-3">
        Назва
    </dt>

    <dd class="col-sm-9">
        @Model.Name
    </dd>


    <dt class="col-sm-3">
        Місто
    </dt>

    <dd class="col-sm-9">
        @Model.Address.City
    </dd>

</dl>


<form method="post"
      asp-action="Delete"
      asp-route-id="@Model.Id">

    <button type="submit"
            class="btn btn-danger">

        Видалити

    </button>

    <a asp-action="Index"
       class="btn btn-secondary">

        Скасувати

    </a>

</form>