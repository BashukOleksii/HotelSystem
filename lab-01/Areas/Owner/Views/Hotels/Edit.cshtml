@model HotelEditViewModel

@{
    ViewData["Title"] =
        "Редагування готелю";
}


<h1 class="mb-4">
    Редагування готелю
</h1>


@if (Model.Hotel.PhotoUrls.Count > 0)
{
    <div class="row g-3 mb-4">

        @foreach (string photo
            in Model.Hotel.PhotoUrls)
        {
            <div class="col-md-3">

                <img src="@photo"
                     alt="@Model.Hotel.Name"
                     class="img-fluid rounded"
                     style="height:180px;width:100%;object-fit:cover;" />

            </div>
        }

    </div>
}


<form method="post"
      enctype="multipart/form-data">

    <div asp-validation-summary="All"
         class="text-danger mb-3">
    </div>


    <div class="mb-3">

        <label asp-for="Form.Name"
               class="form-label">
            Назва
        </label>

        <input asp-for="Form.Name"
               class="form-control" />

    </div>


    <div class="mb-3">

        <label asp-for="Form.Description"
               class="form-label">
            Опис
        </label>

        <textarea asp-for="Form.Description"
                  class="form-control"
                  rows="4">
        </textarea>

    </div>


    <h4>
        Адреса
    </h4>


    <div class="row">

        <div class="col-md-4 mb-3">

            <label asp-for="Form.Address.City"
                   class="form-label">
                Місто
            </label>

            <input asp-for="Form.Address.City"
                   class="form-control" />

        </div>


        <div class="col-md-5 mb-3">

            <label asp-for="Form.Address.Street"
                   class="form-label">
                Вулиця
            </label>

            <input asp-for="Form.Address.Street"
                   class="form-control" />

        </div>


        <div class="col-md-3 mb-3">

            <label asp-for="Form.Address.Number"
                   class="form-label">
                Номер
            </label>

            <input asp-for="Form.Address.Number"
                   class="form-control" />

        </div>

    </div>


    <div class="mb-4">

        <label asp-for="NewPhotos"
               class="form-label">
            Додати фотографії
        </label>

        <input asp-for="NewPhotos"
               type="file"
               multiple
               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
               class="form-control" />

    </div>


    <button type="submit"
            class="btn btn-primary">
        Зберегти
    </button>

    <a asp-action="Details"
       asp-route-id="@Model.Hotel.Id"
       class="btn btn-secondary">
        Скасувати
    </a>

</form>