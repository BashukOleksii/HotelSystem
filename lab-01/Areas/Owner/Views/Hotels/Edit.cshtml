@model HotelUpdateDto

@{
    ViewData["Title"] = "Редагування готелю";
}


<h1 class="mb-4">
    Редагування готелю
</h1>


<form method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>


    <div class="mb-3">

        <label asp-for="Name"
               class="form-label">

            Назва

        </label>

        <input asp-for="Name"
               class="form-control" />

        <span asp-validation-for="Name"
              class="text-danger">
        </span>

    </div>


    <div class="mb-3">

        <label asp-for="Description"
               class="form-label">

            Опис

        </label>

        <textarea asp-for="Description"
                  class="form-control"
                  rows="4">
        </textarea>

    </div>


    <h4>
        Адреса
    </h4>


    <div class="row">

        <div class="col-md-4 mb-3">

            <label asp-for="Address.City"
                   class="form-label">
                Місто
            </label>

            <input asp-for="Address.City"
                   class="form-control" />

        </div>


        <div class="col-md-5 mb-3">

            <label asp-for="Address.Street"
                   class="form-label">
                Вулиця
            </label>

            <input asp-for="Address.Street"
                   class="form-control" />

        </div>


        <div class="col-md-3 mb-3">

            <label asp-for="Address.Number"
                   class="form-label">
                Номер
            </label>

            <input asp-for="Address.Number"
                   class="form-control" />

        </div>

    </div>


    <button type="submit"
            class="btn btn-primary">

        Зберегти

    </button>


    <a asp-action="Index"
       class="btn btn-secondary">

        Скасувати

    </a>

</form>