@model RoomCreateDto

@{
    ViewData["Title"] = "Нова кімната";
}


<h1 class="mb-4">
    Нова кімната
</h1>


<form method="post">

    <input asp-for="HotelId"
           type="hidden" />


    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>


    <div class="mb-3">

        <label asp-for="RoomNumber"
               class="form-label">

            Номер кімнати

        </label>

        <input asp-for="RoomNumber"
               class="form-control" />

        <span asp-validation-for="RoomNumber"
              class="text-danger">
        </span>

    </div>


    <div class="mb-3">

        <label asp-for="Type"
               class="form-label">

            Тип

        </label>

        <select asp-for="Type"
                class="form-select">

            @foreach (
                RoomType roomType
                in Enum.GetValues<RoomType>())
            {
                <option value="@roomType">
                    @roomType
                </option>
            }

        </select>

        <span asp-validation-for="Type"
              class="text-danger">
        </span>

    </div>


    <div class="mb-3">

        <label asp-for="CostPerNight"
               class="form-label">

            Ціна за ніч

        </label>

        <input asp-for="CostPerNight"
               type="number"
               min="0"
               step="0.01"
               class="form-control" />

        <span asp-validation-for="CostPerNight"
              class="text-danger">
        </span>

    </div>


    <div class="mb-3">

        <label asp-for="Capacity"
               class="form-label">

            Місткість

        </label>

        <input asp-for="Capacity"
               type="number"
               min="1"
               class="form-control" />

        <span asp-validation-for="Capacity"
              class="text-danger">
        </span>

    </div>


    <button type="submit"
            class="btn btn-primary">

        Створити

    </button>


    <a asp-action="Index"
       asp-route-hotelId="@Model.HotelId"
       class="btn btn-secondary">

        Скасувати

    </a>

</form>