@model OwnerRoomIndexViewModel

@{
    ViewData["Title"] =
        $"Кімнати - {Model.Hotel.Name}";
}


<div class="d-flex justify-content-between
            align-items-center mb-4">

    <div>

        <h1>
            Кімнати
        </h1>

        <p class="text-muted mb-0">
            @Model.Hotel.Name
        </p>

    </div>


    <div>

        <a asp-area="Owner"
           asp-controller="Rooms"
           asp-action="Create"
           asp-route-hotelId="@Model.Hotel.Id"
           class="btn btn-primary">

            Додати кімнату

        </a>

        <a asp-area="Owner"
           asp-controller="Hotels"
           asp-action="Details"
           asp-route-id="@Model.Hotel.Id"
           class="btn btn-secondary">

            До готелю

        </a>

    </div>

</div>


<form method="get"
      asp-area="Owner"
      asp-controller="Rooms"
      asp-action="Index"
      class="row g-3 mb-4">

    <input type="hidden"
           name="hotelId"
           value="@Model.Hotel.Id" />


    <div class="col-md-3">

        <label class="form-label">
            Пошук
        </label>

        <input type="text"
               name="Search"
               value="@Model.Filter.Search"
               class="form-control"
               placeholder="Номер кімнати" />

    </div>


    <div class="col-md-2">

        <label class="form-label">
            Тип
        </label>

        <select name="Type"
                class="form-select">

            <option value="">
                Всі
            </option>

            @foreach (
                RoomType roomType
                in Enum.GetValues<RoomType>())
            {
                <option value="@roomType"
                        selected="@(Model.Filter.Type == roomType)">

                    @roomType

                </option>
            }

        </select>

    </div>


    <div class="col-md-2">

        <label class="form-label">
            Мін. ціна
        </label>

        <input type="number"
               name="MinPrice"
               value="@Model.Filter.MinPrice"
               class="form-control"
               min="0"
               step="0.01" />

    </div>


    <div class="col-md-2">

        <label class="form-label">
            Макс. ціна
        </label>

        <input type="number"
               name="MaxPrice"
               value="@Model.Filter.MaxPrice"
               class="form-control"
               min="0"
               step="0.01" />

    </div>


    <div class="col-md-2">

        <label class="form-label">
            Мін. місць
        </label>

        <input type="number"
               name="MinCapacity"
               value="@Model.Filter.MinCapacity"
               class="form-control"
               min="1" />

    </div>


    <div class="col-md-1
                d-flex align-items-end">

        <button type="submit"
                class="btn btn-outline-primary w-100">

            ✓

        </button>

    </div>

</form>


@if (Model.Rooms.Items.Count == 0)
{
    <div class="alert alert-info">

        У цьому готелі немає кімнат
        за заданими параметрами.

    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped
                      table-hover align-middle">

            <thead>

            <tr>
                <th>Номер</th>
                <th>Тип</th>
                <th>Місткість</th>
                <th>Ціна / ніч</th>
                <th>Стан</th>

                <th class="text-end">
                    Дії
                </th>
            </tr>

            </thead>

            <tbody>

            @foreach (
                RoomReadDto room
                in Model.Rooms.Items)
            {
                <tr>

                    <td>
                        @room.RoomNumber
                    </td>

                    <td>
                        @room.Type
                    </td>

                    <td>
                        @room.Capacity
                    </td>

                    <td>
                        @room.CostPerNight.ToString("0.00")
                    </td>

                    <td>

                        @if (room.IsAvailable)
                        {
                            <span class="badge bg-success">
                                Доступна
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Недоступна
                            </span>
                        }

                    </td>

                    <td class="text-end">

                        <a asp-action="Details"
                           asp-route-id="@room.Id"
                           class="btn btn-sm
                                  btn-outline-secondary">

                            Деталі

                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@room.Id"
                           class="btn btn-sm
                                  btn-outline-primary">

                            Редагувати

                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@room.Id"
                           class="btn btn-sm
                                  btn-outline-danger">

                            Видалити

                        </a>

                    </td>

                </tr>
            }

            </tbody>

        </table>

        @if (Model.Rooms.TotalPages > 1)
{
    <nav class="mt-3">

        <ul class="pagination">

            @for (
                int pageNumber = 1;
                pageNumber <= Model.Rooms.TotalPages;
                pageNumber++)
            {
                <li class="
                    page-item
                    @(pageNumber == Model.Rooms.Page
                        ? "active"
                        : "")
                ">

                    <a class="page-link"
                       asp-area="Owner"
                       asp-controller="Rooms"
                       asp-action="Index"
                       asp-route-hotelId="@Model.Hotel.Id"
                       asp-route-Search="@Model.Filter.Search"
                       asp-route-Type="@Model.Filter.Type"
                       asp-route-MinPrice="@Model.Filter.MinPrice"
                       asp-route-MaxPrice="@Model.Filter.MaxPrice"
                       asp-route-MinCapacity="@Model.Filter.MinCapacity"
                       asp-route-IsAvailable="@Model.Filter.IsAvailable"
                       asp-route-SortBy="@Model.Filter.SortBy"
                       asp-route-Descending="@Model.Filter.Descending"
                       asp-route-Page="@pageNumber"
                       asp-route-PageSize="@Model.Filter.PageSize">

                        @pageNumber

                    </a>

                </li>
            }

        </ul>

    </nav>
}

    </div>
}