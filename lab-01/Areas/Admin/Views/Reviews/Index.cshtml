@model AdminReviewIndexViewModel

@{
    ViewData["Title"] =
        "Модерація відгуків";
}


<h1 class="mb-4">
    Модерація відгуків
</h1>


@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success">
        @successMessage
    </div>
}


<div asp-validation-summary="All"
     class="text-danger mb-3">
</div>


<form method="get"
      asp-area="Admin"
      asp-controller="Reviews"
      asp-action="Index"
      class="row g-3 mb-4">


    <div class="col-md-4">

        <label class="form-label">
            Пошук
        </label>

        <input type="text"
               name="Search"
               value="@Model.Filter.Search"
               class="form-control"
               placeholder="Текст коментаря" />

    </div>


    <div class="col-md-2">

        <label class="form-label">
            Мін. оцінка
        </label>

        <select name="MinRating"
                class="form-select">

            <option value="">
                Будь-яка
            </option>

            @for (int rating = 1; rating <= 5; rating++)
            {
                <option value="@rating"
                        selected="@(Model.Filter.MinRating == rating)">
                    @rating
                </option>
            }

        </select>

    </div>


    <div class="col-md-2">

        <label class="form-label">
            Макс. оцінка
        </label>

        <select name="MaxRating"
                class="form-select">

            <option value="">
                Будь-яка
            </option>

            @for (int rating = 1; rating <= 5; rating++)
            {
                <option value="@rating"
                        selected="@(Model.Filter.MaxRating == rating)">
                    @rating
                </option>
            }

        </select>

    </div>


    <div class="col-md-2">

        <label class="form-label">
            Сортування
        </label>

        <select name="SortBy"
                class="form-select">

            <option value="">
                За датою
            </option>

            <option value="rating"
                    selected="@(Model.Filter.SortBy == "rating")">
                Оцінка
            </option>

            <option value="createdat"
                    selected="@(Model.Filter.SortBy == "createdat")">
                Дата
            </option>

        </select>

    </div>


    <div class="col-md-2 d-flex align-items-end">

        <button type="submit"
                class="btn btn-primary w-100">
            Застосувати
        </button>

    </div>

</form>


@if (Model.Reviews.Items.Count == 0)
{
    <div class="alert alert-info">
        Відгуків не знайдено.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped
                      table-hover align-middle">

            <thead>

            <tr>
                <th>Готель</th>
                <th>Користувач</th>
                <th>Оцінка</th>
                <th>Коментар</th>
                <th>Дата</th>
                <th class="text-end">Дії</th>
            </tr>

            </thead>

            <tbody>

            @foreach (
                ReviewReadDto review
                in Model.Reviews.Items)
            {
                <tr>

                    <td>
                        @review.HotelName
                    </td>

                    <td>
                        @(review.UserEmail ?? "—")
                    </td>

                    <td>
                        @review.Rating / 5
                    </td>

                    <td>
                        @(string.IsNullOrWhiteSpace(
                            review.Comment)
                            ? "—"
                            : review.Comment)
                    </td>

                    <td>
                        @review.CreatedAt.ToString(
                            "dd.MM.yyyy"
                        )
                    </td>

                    <td class="text-end">

                        <a asp-action="Details"
                           asp-route-id="@review.Id"
                           class="btn btn-sm btn-outline-secondary">

                            Деталі

                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@review.Id"
                           class="btn btn-sm btn-outline-danger">

                            Видалити

                        </a>

                    </td>

                </tr>
            }

            </tbody>

        </table>

    </div>
}


@if (Model.Reviews.TotalPages > 1)
{
    <nav class="mt-3">

        <ul class="pagination">

            @for (
                int pageNumber = 1;
                pageNumber <= Model.Reviews.TotalPages;
                pageNumber++)
            {
                <li class="
                    page-item
                    @(pageNumber == Model.Reviews.Page
                        ? "active"
                        : "")
                ">

                    <a class="page-link"
                       asp-area="Admin"
                       asp-controller="Reviews"
                       asp-action="Index"
                       asp-route-Search="@Model.Filter.Search"
                       asp-route-MinRating="@Model.Filter.MinRating"
                       asp-route-MaxRating="@Model.Filter.MaxRating"
                       asp-route-SortBy="@Model.Filter.SortBy"
                       asp-route-Descending="@Model.Filter.Descending"
                       asp-route-Page="@pageNumber"
                       asp-route-PageSize="@Model.Filter.PageSize">

                        @pageNumber

                    </a>

                </li>
            }

        </ul>

    </nav>
}