@model ReviewReadDto

@{
    ViewData["Title"] =
        "Відгук";
}


<h1 class="mb-4">
    Деталі відгуку
</h1>


<dl class="row">

    <dt class="col-sm-3">
        Готель
    </dt>

    <dd class="col-sm-9">
        @Model.HotelName
    </dd>


    <dt class="col-sm-3">
        Користувач
    </dt>

    <dd class="col-sm-9">
        @(Model.UserEmail ?? "—")
    </dd>


    <dt class="col-sm-3">
        Оцінка
    </dt>

    <dd class="col-sm-9">
        @Model.Rating / 5
    </dd>


    <dt class="col-sm-3">
        Коментар
    </dt>

    <dd class="col-sm-9">
        @(string.IsNullOrWhiteSpace(Model.Comment)
            ? "—"
            : Model.Comment)
    </dd>


    <dt class="col-sm-3">
        Створено
    </dt>

    <dd class="col-sm-9">
        @Model.CreatedAt.ToString(
            "dd.MM.yyyy HH:mm"
        )
    </dd>

</dl>

@if (Model.PhotoUrls.Count > 0)
{
    <h4 class="mt-4">
        Фотографії
    </h4>

    <div class="row g-3 mb-4">

        @foreach (string photo
            in Model.PhotoUrls)
        {
            <div class="col-md-4">

                <img src="@photo"
                     alt="Фото відгуку"
                     class="img-fluid rounded"
                     style="height:220px;width:100%;object-fit:cover;" />

            </div>
        }

    </div>
}

<a asp-action="Delete"
   asp-route-id="@Model.Id"
   class="btn btn-danger">
    Видалити
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Назад
</a>