@model AdminUserIndexViewModel

@{
    ViewData["Title"] =
        "Користувачі";
}


<div class="d-flex justify-content-between
            align-items-center mb-4">

    <h1>
        Користувачі
    </h1>

    <a asp-area="Admin"
       asp-controller="Users"
       asp-action="Create"
       class="btn btn-primary">

        Створити користувача

    </a>

</div>


@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success">
        @successMessage
    </div>
}


<div asp-validation-summary="All"
     class="text-danger mb-3">
</div>


<form method="get"
      asp-area="Admin"
      asp-controller="Users"
      asp-action="Index"
      class="row g-3 mb-4">


    <div class="col-md-5">

        <label class="form-label">
            Пошук
        </label>

        <input type="text"
               name="Search"
               value="@Model.Filter.Search"
               class="form-control"
               placeholder="Username, Email або телефон" />

    </div>


    <div class="col-md-3">

        <label class="form-label">
            Сортування
        </label>

        <select name="SortBy"
                class="form-select">

            <option value="">
                Username
            </option>

            <option value="username"
                    selected="@(Model.Filter.SortBy == "username")">
                Username
            </option>

            <option value="email"
                    selected="@(Model.Filter.SortBy == "email")">
                Email
            </option>

            <option value="createdat"
                    selected="@(Model.Filter.SortBy == "createdat")">
                Дата створення
            </option>

        </select>

    </div>


    <div class="col-md-2">

        <label class="form-label">
            Порядок
        </label>

        <select name="Descending"
                class="form-select">

            <option value="false"
                    selected="@(!Model.Filter.Descending)">
                Зростання
            </option>

            <option value="true"
                    selected="@Model.Filter.Descending">
                Спадання
            </option>

        </select>

    </div>


    <div class="col-md-2 d-flex align-items-end">

        <button type="submit"
                class="btn btn-outline-primary w-100">

            Застосувати

        </button>

    </div>

</form>


@if (Model.Users.Items.Count == 0)
{
    <div class="alert alert-info">
        Користувачів не знайдено.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped
                      table-hover align-middle">

            <thead>

            <tr>
                <th>Username</th>
                <th>Email</th>
                <th>Телефон</th>
                <th>Роль</th>
                <th>Створено</th>
                <th class="text-end">Дії</th>
            </tr>

            </thead>

            <tbody>

            @foreach (
                UserReadDto user
                in Model.Users.Items)
            {
                <tr>

                    <td>
                        @user.UserName
                    </td>

                    <td>
                        @user.Email
                    </td>

                    <td>
                        @(user.PhoneNumber ?? "—")
                    </td>

                    <td>
                        @(user.Roles.Count > 0
                            ? string.Join(", ", user.Roles)
                            : "—")
                    </td>

                    <td>
                        @user.CreatedAt.ToString(
                            "dd.MM.yyyy"
                        )
                    </td>

                    <td class="text-end">

                        <a asp-action="Details"
                           asp-route-id="@user.Id"
                           class="btn btn-sm btn-outline-secondary">

                            Деталі

                        </a>

                        @if (!user.Roles.Contains("Admin"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@user.Id"
                               class="btn btn-sm btn-outline-primary">

                                Редагувати

                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@user.Id"
                               class="btn btn-sm btn-outline-danger">

                                Видалити

                            </a>
                        }

                    </td>

                </tr>
            }

            </tbody>

        </table>

    </div>
}


@if (Model.Users.TotalPages > 1)
{
    <nav class="mt-3">

        <ul class="pagination">

            @for (
                int pageNumber = 1;
                pageNumber <= Model.Users.TotalPages;
                pageNumber++)
            {
                <li class="
                    page-item
                    @(pageNumber == Model.Users.Page
                        ? "active"
                        : "")
                ">

                    <a class="page-link"
                       asp-area="Admin"
                       asp-controller="Users"
                       asp-action="Index"
                       asp-route-Search="@Model.Filter.Search"
                       asp-route-SortBy="@Model.Filter.SortBy"
                       asp-route-Descending="@Model.Filter.Descending"
                       asp-route-Page="@pageNumber"
                       asp-route-PageSize="@Model.Filter.PageSize">

                        @pageNumber

                    </a>

                </li>
            }

        </ul>

    </nav>
}