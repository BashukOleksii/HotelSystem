@model UserReadDto

@{
    ViewData["Title"] =
        "Користувач";
}


@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success">
        @successMessage
    </div>
}


<h1 class="mb-4">
    Користувач
</h1>


<dl class="row">

    <dt class="col-sm-3">
        Username
    </dt>

    <dd class="col-sm-9">
        @Model.UserName
    </dd>


    <dt class="col-sm-3">
        Email
    </dt>

    <dd class="col-sm-9">
        @Model.Email
    </dd>


    <dt class="col-sm-3">
        Телефон
    </dt>

    <dd class="col-sm-9">
        @(Model.PhoneNumber ?? "—")
    </dd>


    <dt class="col-sm-3">
        Ролі
    </dt>

    <dd class="col-sm-9">
        @(Model.Roles.Count > 0
            ? string.Join(", ", Model.Roles)
            : "—")
    </dd>


    <dt class="col-sm-3">
        Створено
    </dt>

    <dd class="col-sm-9">
        @Model.CreatedAt.ToString(
            "dd.MM.yyyy HH:mm"
        )
    </dd>


    <dt class="col-sm-3">
        Оновлено
    </dt>

    <dd class="col-sm-9">
        @Model.UpdatedAt.ToString(
            "dd.MM.yyyy HH:mm"
        )
    </dd>

</dl>


@if (!Model.Roles.Contains("Admin"))
{
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        Редагувати
    </a>

    <a asp-action="Delete"
       asp-route-id="@Model.Id"
       class="btn btn-danger">
        Видалити
    </a>
}


<a asp-action="Index"
   class="btn btn-secondary">
    Назад
</a>