<!DOCTYPE html>

<html lang="uk">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - HotelSystem
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header>
       @if (User.Identity?.IsAuthenticated == true)
{
    <span class="navbar-text text-light ms-3">

        @User.Identity.Name

    </span>

    <form
        method="post"
        asp-area=""
        asp-controller="Account"
        asp-action="Logout"
        class="ms-3">

        <button
            type="submit"
            class="btn btn-outline-light">

            Вийти

        </button>

    </form>
}
else
{
    <a
        class="nav-link"
        asp-area=""
        asp-controller="Account"
        asp-action="Login">

        Увійти

    </a>

    <a
        class="nav-link"
        asp-area=""
        asp-controller="Account"
        asp-action="Register">

        Реєстрація

    </a>
}
    </header>


    <main class="container py-4">

        @RenderBody()

    </main>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>