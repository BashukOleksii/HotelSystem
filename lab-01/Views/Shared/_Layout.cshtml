<!DOCTYPE html>

<html lang="uk">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - HotelSystem
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

            <div class="container">

                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Hotels"
                   asp-action="Index">

                    HotelSystem

                </a>

                <div class="navbar-nav">

                    <a class="nav-link"
                       asp-area=""
                       asp-controller="Hotels"
                       asp-action="Index">

                        Готелі

                    </a>

                </div>

            </div>

        </nav>
    </header>


    <main class="container py-4">

        @RenderBody()

    </main>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>