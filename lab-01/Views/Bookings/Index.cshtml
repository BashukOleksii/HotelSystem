@model UserBookingIndexViewModel

@{
    ViewData["Title"] =
        "Мої бронювання";
}


<h1 class="mb-4">
    Мої бронювання
</h1>


@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success">
        @successMessage
    </div>
}


<div asp-validation-summary="All"
     class="text-danger mb-3">
</div>


<form method="get"
      asp-controller="Bookings"
      asp-action="Index"
      class="row g-3 mb-4">


    <div class="col-md-3">

        <label class="form-label">
            Від
        </label>

        <input type="date"
               name="From"
               value="@Model.Filter.From?.ToString("yyyy-MM-dd")"
               class="form-control" />

    </div>


    <div class="col-md-3">

        <label class="form-label">
            До
        </label>

        <input type="date"
               name="To"
               value="@Model.Filter.To?.ToString("yyyy-MM-dd")"
               class="form-control" />

    </div>


    <div class="col-md-3">

        <label class="form-label">
            Сортування
        </label>

        <select name="SortBy"
                class="form-select">

            <option value="">
                За датою створення
            </option>

            <option value="checkin"
                    selected="@(Model.Filter.SortBy == "checkin")">
                Заселення
            </option>

            <option value="checkout"
                    selected="@(Model.Filter.SortBy == "checkout")">
                Виселення
            </option>

            <option value="price"
                    selected="@(Model.Filter.SortBy == "price")">
                Вартість
            </option>

            <option value="createdat"
                    selected="@(Model.Filter.SortBy == "createdat")">
                Дата створення
            </option>

        </select>

    </div>


    <div class="col-md-2">

        <label class="form-label">
            Порядок
        </label>

        <select name="Descending"
                class="form-select">

            <option value="false"
                    selected="@(!Model.Filter.Descending)">
                Зростання
            </option>

            <option value="true"
                    selected="@Model.Filter.Descending">
                Спадання
            </option>

        </select>

    </div>


    <div class="col-md-1 d-flex align-items-end">

        <button type="submit"
                class="btn btn-primary w-100">

            ✓

        </button>

    </div>

</form>


@if (Model.Bookings.Items.Count == 0)
{
    <div class="alert alert-info">

        Бронювань не знайдено.

    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped
                      table-hover align-middle">

            <thead>

            <tr>
                <th>Готель</th>
                <th>Кімната</th>
                <th>Заселення</th>
                <th>Виселення</th>
                <th>Ночей</th>
                <th>Вартість</th>
                <th class="text-end">Дії</th>
            </tr>

            </thead>


            <tbody>

            @foreach (
                BookingReadDto booking
                in Model.Bookings.Items)
            {
                <tr>

                    <td>
                        @booking.HotelName
                    </td>

                    <td>
                        @booking.RoomNumber
                    </td>

                    <td>
                        @booking.CheckIn.ToString("dd.MM.yyyy")
                    </td>

                    <td>
                        @booking.CheckOut.ToString("dd.MM.yyyy")
                    </td>

                    <td>
                        @((booking.CheckOut.Date -
                           booking.CheckIn.Date).Days)
                    </td>

                    <td>
                        @booking.TotalPrice.ToString("0.00")
                    </td>

                    <td class="text-end">

                        <a asp-action="Details"
                           asp-route-id="@booking.Id"
                           class="btn btn-sm btn-outline-secondary">

                            Деталі

                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@booking.Id"
                           class="btn btn-sm btn-outline-primary">

                            Змінити

                        </a>

                        <a asp-action="Cancel"
                           asp-route-id="@booking.Id"
                           class="btn btn-sm btn-outline-danger">

                            Скасувати

                        </a>

                    </td>

                </tr>
            }

            </tbody>

        </table>

    </div>
}


@if (Model.Bookings.TotalPages > 1)
{
    <nav class="mt-3">

        <ul class="pagination">

            @for (
                int pageNumber = 1;
                pageNumber <= Model.Bookings.TotalPages;
                pageNumber++)
            {
                <li class="
                    page-item
                    @(pageNumber == Model.Bookings.Page
                        ? "active"
                        : "")
                ">

                    <a class="page-link"
                       asp-controller="Bookings"
                       asp-action="Index"
                       asp-route-From="@Model.Filter.From?.ToString("yyyy-MM-dd")"
                       asp-route-To="@Model.Filter.To?.ToString("yyyy-MM-dd")"
                       asp-route-SortBy="@Model.Filter.SortBy"
                       asp-route-Descending="@Model.Filter.Descending"
                       asp-route-Page="@pageNumber"
                       asp-route-PageSize="@Model.Filter.PageSize">

                        @pageNumber

                    </a>

                </li>
            }

        </ul>

    </nav>
}