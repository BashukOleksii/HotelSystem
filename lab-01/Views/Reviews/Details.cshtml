@model ReviewReadDto

@{
    ViewData["Title"] =
        "Деталі відгуку";
}


@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success">
        @successMessage
    </div>
}


<h1 class="mb-4">
    Деталі відгуку
</h1>


<dl class="row">

    <dt class="col-sm-3">
        Готель
    </dt>

    <dd class="col-sm-9">
        @Model.HotelName
    </dd>


    <dt class="col-sm-3">
        Оцінка
    </dt>

    <dd class="col-sm-9">
        @Model.Rating / 5
    </dd>


    <dt class="col-sm-3">
        Коментар
    </dt>

    <dd class="col-sm-9">
        @(string.IsNullOrWhiteSpace(Model.Comment)
            ? "—"
            : Model.Comment)
    </dd>


    <dt class="col-sm-3">
        Створено
    </dt>

    <dd class="col-sm-9">
        @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
    </dd>

</dl>


<a asp-action="Edit"
   asp-route-id="@Model.Id"
   class="btn btn-primary">

    Редагувати

</a>


<a asp-action="Delete"
   asp-route-id="@Model.Id"
   class="btn btn-danger">

    Видалити

</a>


<a asp-action="Index"
   class="btn btn-secondary">

    Назад

</a>