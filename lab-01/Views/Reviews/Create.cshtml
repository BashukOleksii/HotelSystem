@model ReviewCreateViewModel

@{
    ViewData["Title"] =
        "Новий відгук";
}


<h1 class="mb-4">
    Новий відгук
</h1>


<div class="card mb-4">

    <div class="card-body">

        <h4>
            @Model.Hotel.Name
        </h4>

        <p class="mb-0">

            @Model.Hotel.Address.City,
            @Model.Hotel.Address.Street
            @Model.Hotel.Address.Number

        </p>

    </div>

</div>


<form method="post"
      enctype="multipart/form-data">

    <input asp-for="Form.HotelId"
           type="hidden" />


    <div asp-validation-summary="All"
         class="text-danger mb-3">
    </div>


    <div class="mb-3">

        <label asp-for="Form.Rating"
               class="form-label">

            Оцінка

        </label>

        <select asp-for="Form.Rating"
                class="form-select">

            <option value="5">5 — Відмінно</option>
            <option value="4">4 — Добре</option>
            <option value="3">3 — Нормально</option>
            <option value="2">2 — Погано</option>
            <option value="1">1 — Дуже погано</option>

        </select>

        <span asp-validation-for="Form.Rating"
              class="text-danger">
        </span>

    </div>


    <div class="mb-3">

        <label asp-for="Form.Comment"
               class="form-label">

            Коментар

        </label>

        <textarea asp-for="Form.Comment"
                  class="form-control"
                  rows="6">
        </textarea>

        <span asp-validation-for="Form.Comment"
              class="text-danger">
        </span>

    </div>

    <div class="mb-4">

    <label asp-for="Photos"
           class="form-label">
        Фотографії
    </label>

    <input asp-for="Photos"
           type="file"
           multiple
           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
           class="form-control" />

    <div class="form-text">
        До 5 фотографій. Максимальний розмір одного файла — 5 МБ.
    </div>

</div>

    <button type="submit"
            class="btn btn-primary">

        Додати відгук

    </button>


    <a asp-controller="Hotels"
       asp-action="Details"
       asp-route-id="@Model.Hotel.Id"
       class="btn btn-secondary">

        Назад

    </a>

</form>